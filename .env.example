# Copy to .env and adjust. Every field in backend/config.py can be overridden here.
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=gemma3:1b
LLM_FALLBACK_MODEL=gemma3:4b
EMBED_MODEL=nomic-embed-text
RAG_MIN_SCORE=0.62
CHAT_CONTEXT_CHARS=2400
CHAT_CONTEXT_HITS=3
CHAT_HISTORY_CHARS=1800
SPEECH_CPU_THREADS=2
SPEECH_RECORDING_LIMIT_S=30
SPEECH_SENTENCE_CHARS=500
STT_MODEL=small
TTS_VOICE=af_heart
GESTURE_MIN_CONF=0.5
GESTURE_HOLD_MS=500
GESTURE_COOLDOWN_MS=1500
ENABLE_KANNADA=false
# Optional, only for scraper/scrape_github.py (public data, higher rate limit)
GITHUB_TOKEN=

# Copy to .env and fill in. Never commit .env. Every field in backend/config.py can be overridden here.

# --- Keys (backend only, never shipped to the browser) ---
# Gemini: https://aistudio.google.com/apikey (Live voice, Look vision, embeddings, text failover)
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys. Comma separated, ideally from different accounts, rotated on HTTP 429.
GROQ_API_KEYS=
# Optional: public read-only GitHub token for scraper/scrape_github.py (higher rate limit)
GITHUB_TOKEN=

# --- Model IDs (T0.2 verification and sources in PROGRESS.md) ---
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_BACKUP_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah

# Text failover order. Groq is primary; Gemini's OpenAI-compatible endpoint takes over if Groq is unreachable.
TEXT_PROVIDERS=groq,gemini,gemini-backup

# --- Feature flags ---
LIVE_ENABLED=true

# --- RAG ---
RAG_MIN_SCORE=0.62

# Copy to .env and adjust. Every field in backend/config.py can be overridden here.
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=gemma3:4b
LLM_FALLBACK_MODEL=qwen3:4b
EMBED_MODEL=nomic-embed-text
RAG_MIN_SCORE=0.62
GESTURE_MIN_CONF=0.5
ENABLE_KANNADA=false
# Optional, only for scraper/scrape_github.py (public data, higher rate limit)
GITHUB_TOKEN=
